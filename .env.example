# ============================================================================
# LaunchPad Environment Configuration
# Copy this file to .env in local development. Never commit real secrets.
# ============================================================================

# 1. Supabase Backend Platform
# Obtain from your Supabase Dashboard (Settings -> API) or local CLI (`supabase status`)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-placeholder

# 2. Privileged Service Role Key (Used exclusively by background ingestion worker)
# NEVER expose this key in client-side code or public repositories
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
