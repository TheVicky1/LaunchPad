# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI, e.g. local or MongoDB Atlas)
# If left empty or unreachable, the server safely runs in local demo fallback mode
MONGODB_URI=mongodb://localhost:27017/launchpad

# Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Authentication Secret
JWT_SECRET=launchpad_super_secure_jwt_secret_key_2026
